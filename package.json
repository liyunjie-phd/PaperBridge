{
  "name": "paper-bridge",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local bilingual LaTeX editor with AI translation and Overleaf synchronization",
  "author": "PaperBridge",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "test": "node --test",
    "versions:show": "node scripts/product-version.mjs show",
    "versions:check": "node scripts/product-version.mjs check",
    "versions:set": "node scripts/product-version.mjs set",
    "build:dir": "npm run versions:check && electron-builder --dir --win --x64 --publish never",
    "build:windows": "npm run versions:check && electron-builder --win nsis --x64 --publish never",
    "build:windows:slim": "npm run versions:check && electron-builder --config build/electron-builder.slim.cjs --win nsis --x64 --publish never",
    "build:setup": "npm run build:windows",
    "build:setup:slim": "npm run build:windows:slim",
    "build:mac": "npm run versions:check && electron-builder --config build/electron-builder.mac.cjs --mac dmg zip --universal --publish never",
    "build:mac:x64": "npm run versions:check && electron-builder --config build/electron-builder.mac.cjs --mac dmg zip --x64 --publish never",
    "build:mac:arm64": "npm run versions:check && electron-builder --config build/electron-builder.mac.cjs --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "dugite": "^3.2.2",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "katex": "^0.16.9",
    "lucide": "^1.24.0",
    "pdfjs-dist": "^6.1.200",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.61.1",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.paperbridge.desktop",
    "productName": "PaperBridge",
    "artifactName": "PaperBridge-Setup.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/dugite/git/**/*"
    ],
    "files": [
      "electron-main.js",
      "preload.cjs",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "resources/icon.png",
      "package.json",
      "!config.local.json",
      "!data/**/*",
      "!test/**/*",
      "!*.log",
      "!*.png"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "tectonic.exe",
          "darwin-x64/tectonic",
          "darwin-arm64/tectonic"
        ]
      }
    ],
    "directories": {
      "output": "release/windows"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "PaperBridge-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
